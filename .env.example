# Database
DB_NAME=nucleagent
DB_PASSWORD=nucleagent_test
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
MYSQL_HOST_PORT=26606

# Redis
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=26679

# JWT (auth 和 core 共享)
JWT_SECRET=change-me-in-production

# S2S (core ↔ executor，注册/心跳/WebSocket 校验 X-Executor-Token)
EXECUTOR_TOKEN=change-me-in-production

# nucleagent-auth
AUTH_PORT=26670
AUTH_WEB_PORT=26678

# nucleagent-core
CORE_PORT=26680
CORE_WEB_PORT=26688
EXECUTOR_URL=http://nucleagent-executor:26690

# nucleagent-executor
EXECUTOR_PORT=26690
EXECUTOR_WEB_PORT=26698
CORE_URL=http://nucleagent-core:26680
DATA_DIR=./data

# CORS (前端来源白名单，支持分布式部署)
WEB_FRONTEND_URL=http://localhost:26600
AUTH_FRONTEND_URL=http://localhost:26678
CORE_FRONTEND_URL=http://localhost:26688
EXECUTOR_FRONTEND_URL=http://localhost:26698
