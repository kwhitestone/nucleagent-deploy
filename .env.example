# Database
DB_NAME=nucleagent
DB_PASSWORD=nucleagent_test
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
MYSQL_HOST_PORT=26606

# Redis
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=26679

# JWT (auth 和 core 共享)
JWT_SECRET=change-me-in-production

# S2S (core ↔ executor，注册/心跳/WebSocket 校验 X-Executor-Token)
EXECUTOR_TOKEN=change-me-in-production

# Provider API key 加密主密钥（core 用 AES-GCM 加解密 providers.api_key）。
# 32 字节：64 位 hex 或 32 位原始字符串。生成：openssl rand -hex 32
#
# ⚠️ 一旦用它加密过 provider key，就**不能再改**——换了值，DB 里已有的
# 密文永久解不开，必须重新录入所有 provider 的 API key。
# 未设置时 core 不会启动失败，而是每次 LLM 调用都失败（历史上曾表现为
# 误导性的 401 "invalid or expired llm proxy key"，见 llmproxy/proxy.go）。
MASTER_KEY=change-me-openssl-rand-hex-32

# nucleagent-auth
AUTH_PORT=26670
AUTH_WEB_PORT=26678

# nucleagent-core
CORE_PORT=26680
CORE_WEB_PORT=26688
EXECUTOR_URL=http://nucleagent-executor:26690
# core 前端直连 storage 上传附件（浏览器直传 CS，不经 core 代理字节流）。
# 必须是**浏览器可达**的地址，不能用 docker service 名。
VITE_STORAGE_URL=http://localhost:26610

# nucleagent-executor
EXECUTOR_PORT=26690
EXECUTOR_WEB_PORT=26698
CORE_URL=http://nucleagent-core:26680
DATA_DIR=./data

# nucleagent-storage
STORAGE_PORT=26610
STORAGE_URL=http://nucleagent-storage:26610
STORAGE_PROVIDER=local                       # local(开发) / cs(生产)
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_LOCAL_BASE_URL=http://localhost:26610
STORAGE_SIGN_SECRET=change-me-in-production  # LocalProvider 上传/下载 URL 签名密钥

# CS 存储后端凭据（仅 STORAGE_PROVIDER=cs 时需要）
# 真实凭据只写进 .env（已被 .gitignore 排除），不要提交到本仓库。
CS_HOST=https://cs.101.com/v0.1
CS_CDN_HOST=https://gcdncs.101.com/v0.1     # 下载走 gcdncs，不是 cdncs
# CS 顶层目录与签名 token 首段。必须是 agentia —— CS 凭据绑定在 agentia 服务
# 空间上，nucleagent 复用它；填 nucleagent 会指向不存在的服务空间，上传直接失败。
CS_SERVER_NAME=agentia
CS_ACCESS_KEY=
CS_SECRET_KEY=
CS_USER_ID=0                                 # "0" = 服务账号

# CORS (前端来源白名单，支持分布式部署)
WEB_FRONTEND_URL=http://localhost:26600
AUTH_FRONTEND_URL=http://localhost:26678
CORE_FRONTEND_URL=http://localhost:26688
EXECUTOR_FRONTEND_URL=http://localhost:26698
