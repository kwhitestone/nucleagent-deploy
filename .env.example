# Database
DB_NAME=nucleagent
DB_PASSWORD=nucleagent_test
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
MYSQL_HOST_PORT=26606

# Redis
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=26679

# JWT (auth 和 core 共享)
JWT_SECRET=change-me-in-production

# S2S (core ↔ executor，注册/心跳/WebSocket 校验 X-Executor-Token)
EXECUTOR_TOKEN=change-me-in-production

# nucleagent-auth
AUTH_PORT=26670
AUTH_WEB_PORT=26678

# nucleagent-core
CORE_PORT=26680
CORE_WEB_PORT=26688
EXECUTOR_URL=http://nucleagent-executor:26690

# nucleagent-executor
EXECUTOR_PORT=26690
EXECUTOR_WEB_PORT=26698
CORE_URL=http://nucleagent-core:26680
DATA_DIR=./data

# nucleagent-storage
STORAGE_PORT=26610
STORAGE_URL=http://nucleagent-storage:26610
STORAGE_PROVIDER=local                       # local(开发) / cs(生产)
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_LOCAL_BASE_URL=http://localhost:26610
STORAGE_SIGN_SECRET=change-me-in-production  # LocalProvider 上传/下载 URL 签名密钥

# CS 存储后端凭据（仅 STORAGE_PROVIDER=cs 时需要）
# 真实凭据只写进 .env（已被 .gitignore 排除），不要提交到本仓库。
CS_HOST=https://cs.101.com/v0.1
CS_CDN_HOST=https://gcdncs.101.com/v0.1     # 下载走 gcdncs，不是 cdncs
CS_SERVER_NAME=nucleagent                    # CS 上的顶层目录与签名 token 首段
CS_ACCESS_KEY=
CS_SECRET_KEY=
CS_USER_ID=0                                 # "0" = 服务账号

# CORS (前端来源白名单，支持分布式部署)
WEB_FRONTEND_URL=http://localhost:26600
AUTH_FRONTEND_URL=http://localhost:26678
CORE_FRONTEND_URL=http://localhost:26688
EXECUTOR_FRONTEND_URL=http://localhost:26698
